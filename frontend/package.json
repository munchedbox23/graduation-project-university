    "pre-commit": "lint-staged",
    "prepare": "husky",
    "generate:slice": "node ./scripts/feature-sliced-design-structure/index.js"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{ts,tsx}": [
      "prettier --list-different",
      "eslint"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
